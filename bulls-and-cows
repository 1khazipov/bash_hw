#!/bin/bash
# Задача 2. Быки и коровы

trap 'echo; echo "Чтобы завершить игру, введите q или Q"' SIGINT

# загадываем 4-значное число с разными цифрами (первая цифра не 0)
secret=$((RANDOM % 9 + 1))
while [[ ${#secret} -lt 4 ]]; do
    digit=$((RANDOM % 10))
    if [[ "$secret" != *"$digit"* ]]; then secret="$secret$digit"; fi
done

echo "********************************************************************************"
echo "* Я загадал 4-значное число с неповторяющимися цифрами. На каждом ходу делайте *"
echo "* попытку отгадать загаданное число. Попытка - это 4-значное число с           *"
echo "* неповторяющимися цифрами.                                                    *"
echo "********************************************************************************"

step=1
history=()
while true; do
    read -p "Попытка $step: " guess
    status=$?
    if ((status > 128)); then continue; fi   # нажали Ctrl+C - спрашиваем заново
    if ((status != 0)); then exit 1; fi      # нажали Ctrl+D - выходим

    if [[ "$guess" == [qQ] ]]; then
        echo "Выход из игры. Загаданное число: $secret"
        exit 1
    fi
    if [[ ! "$guess" =~ ^[1-9][0-9]{3}$ ]]; then
        echo "Ошибка! Нужно ввести 4-значное число с неповторяющимися цифрами."
        continue
    fi

    # проверка на повторы: есть ли цифра еще раз правее себя
    repeat=0
    for ((i = 0; i < 3; i++)); do
        if [[ "${guess:i+1}" == *"${guess:i:1}"* ]]; then repeat=1; fi
    done
    if ((repeat == 1)); then
        echo "Ошибка! Цифры не должны повторяться."
        continue
    fi

    # бык - цифра на своем месте, корова - цифра есть, но на другом месте
    bulls=0
    cows=0
    for ((i = 0; i < 4; i++)); do
        if [[ "${secret:i:1}" == "${guess:i:1}" ]]; then
            ((bulls++))
        elif [[ "$secret" == *"${guess:i:1}"* ]]; then
            ((cows++))
        fi
    done

    echo "Коров - $cows Быков - $bulls"
    history+=("$step. $guess (Коров - $cows Быков - $bulls)")
    echo -e "\nИстория ходов:"
    for line in "${history[@]}"; do echo "$line"; done
    echo

    if ((bulls == 4)); then
        echo "Поздравляю! Вы угадали число $secret"
        exit 0
    fi
    ((step++))
done
